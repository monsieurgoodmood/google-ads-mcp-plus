# -----------------------------------------------------------------------------
# Copy to .env (which is gitignored) and fill in your own values.
# NEVER commit real values. The developer token in particular is a secret.
# -----------------------------------------------------------------------------

# Google Ads API developer token (from the Google Ads API Center).
# A "test account only" token CANNOT query production accounts — request at
# least Basic/Explorer access. See docs/setup-oauth.md.
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEVELOPER_TOKEN

# OPTIONAL: only set if your ADC file is not in the default gcloud location.
# By default the client library finds Application Default Credentials on its own.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json

# OPTIONAL: default manager (MCC) account. Can also live in config.yaml.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=YOUR_MCC_ID

# -----------------------------------------------------------------------------
# For the official READ-ONLY MCP server (docs/read-mcp.md) you will also set,
# in your MCP host config (not here):
#   GOOGLE_PROJECT_ID / GOOGLE_CLOUD_PROJECT  = your Google Cloud project ID
#   GOOGLE_ADS_DEVELOPER_TOKEN                = same token as above
#   GOOGLE_APPLICATION_CREDENTIALS            = path to your OAuth/ADC JSON
# -----------------------------------------------------------------------------
