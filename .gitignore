# =============================================================================
# SECRETS / CREDENTIALS — never commit. Verify this file before every `git add`.
# =============================================================================
.env
*.env
!.env.example
application_default_credentials.json
*application_default_credentials*.json
*credentials*.json
*client_secret*.json
client_id*.json
service-account*.json
*.pem
*.key
# Git does NOT support trailing comments on pattern lines — a comment here
# would become part of the pattern and silently stop ignoring the file.
google-ads.yaml

# Your private campaign config(s). The example/template is kept.
config.yaml
config.yml
config.*.yaml
config.*.yml
!config.example.yaml
!examples/*.yaml

